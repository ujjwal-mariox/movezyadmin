# Public site URL (canonical links, sitemap, Open Graph); confirm before deployment
VITE_SITE_URL=
VITE_DEMO_MODE=false

# Backend API base — the contact form and the policy pages read from here
VITE_API_URL=https://movezybackend.onrender.com/v1/api

# Client-approved contact details; blank values are hidden
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=Pune, Maharashtra, India
VITE_PARTNER_EMAIL=
VITE_PARTNER_PHONE=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=
# Phone values must include country code (E.164), e.g. +91 followed by 10 digits.
VITE_WHATSAPP_PHONE=
VITE_LEGAL_COMPANY_NAME=

# Basic SEO / page tag only. Do not enable until the client supplies real values.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_GA4_MEASUREMENT_ID=
# Disable Enhanced Measurement in the GA4 web stream to avoid extra events.

# Store links — leave empty until the apps are published (buttons show "Coming soon")
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
VITE_DRIVER_PLAY_STORE_URL=

# Social links (optional)
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=
